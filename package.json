{
  "name": "car-repair-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd api && php -S 0.0.0.0:8000 index.php",
    "dev:frontend": "cd CarRepairShop && npm run dev",
    "build": "cd CarRepairShop && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright-core": "^1.64.1"
  }
}
