{
  "name": "car-repair-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "php -S localhost:8000 -t api",
    "dev:frontend": "cd CarRepairShop && npm run dev",
    "free:port": "powershell -Command \"Get-NetTCPConnection -LocalPort 8000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\"",
    "build": "cd CarRepairShop && npm run build",
    "start": "php -S localhost:8000 -t api"
  }
}
