{
  "name": "car-repair-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd api && php -S 0.0.0.0:8000 index.php",
    "dev:frontend": "cd CarRepairShop && npm run dev",
    "build": "cd CarRepairShop && npm run build",
    "lint": "cd CarRepairShop && npm run lint",
    "test:db": "php api/tests/integration_test.php && php api/tests/rls_lockdown_test.php",
    "test:api": "php api/tests/jwt_test.php && php api/tests/db_error_test.php && php api/tests/db_globals_test.php && php api/tests/password_test.php && php -d apc.enable_cli=1 api/tests/cache_test.php"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright-core": "^1.64.1"
  }
}
