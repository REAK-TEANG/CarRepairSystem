# ==============================================================================
# Car Repair Management System — Environment Configuration
# ==============================================================================

# Application Environment: development | production
APP_ENV=development

# Frontend Client URL (Whitelisted for CORS with credentials)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carrepairshop
DB_USER=postgres
DB_PASSWORD=123

# Performance: Enable PDO Persistent Connection Pooling
DB_PERSISTENT=true

# Security: JWT Secret Key (Generate a cryptographically secure 64+ char random string)
JWT_SECRET=carrepair_super_secret_jwt_key_2026_x89!@#%^&_workshop_pro
